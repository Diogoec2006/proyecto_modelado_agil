# ====================================================================
# Configuración del Servidor y Base de Datos Supabase
# ====================================================================

PORT=3000

# URL de tu proyecto en Supabase (ej: https://xyzprojectid.supabase.co)
# Obtenida en: Supabase Dashboard -> Project Settings -> API -> Project URL
SUPABASE_URL=https://tu-proyecto.supabase.co

# Llave API anónima o clave de servicio de Supabase (anon / public o service_role)
# Obtenida en: Supabase Dashboard -> Project Settings -> API -> Project API keys
SUPABASE_KEY=tu-anon-key-de-supabase-aqui

# (Opcional) Service Role Key para operaciones administrativas sin restricciones RLS
SUPABASE_SERVICE_ROLE_KEY=

